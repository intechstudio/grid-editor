{
  "name": "grid-editor",
  "productName": "Grid Editor",
  "description": "Powerful Editor software for Intech Studio products.",
  "version": "1.5.8",
  "engines": {
    "node": ">=18.16.1"
  },
  "main": "dist/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/intechstudio/grid-editor.git"
  },
  "devDependencies": {
    "@melt-ui/pp": "^0.3.2",
    "@melt-ui/svelte": "^0.84.0",
    "@playwright/test": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "^2.4.5",
    "@types/node": "^20.11.21",
    "autoprefixer": "^10.4.12",
    "chai": "^4.3.4",
    "cross-env": "^7.0.2",
    "dotenv": "^14.2.0",
    "electron": "^28.3.2",
    "electron-builder": "^26.0.11",
    "electron-vite": "^1.0.27",
    "mocha": "^11.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.18",
    "postcss-load-config": "^4.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "rollup-plugin-copy": "^3.4.0",
    "svelte": "^4.2.0",
    "svelte-check": "^4.2.2",
    "svelte-grid": "^1.11.2",
    "svelte-preprocess": "^5.0.3",
    "tailwindcss": "^3.4.17",
    "vite-plugin-commonjs": "^0.6.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@intechstudio/grid-protocol": "1.20250630.1305",
    "@intechstudio/grid-uikit": "1.20250703.1147",
    "@intechstudio/profile-cloud-webcomponent": "1.20250318.1527",
    "adm-zip": "^0.5.10",
    "axios": "^1.9.0",
    "cheerio": "^1.0.0",
    "chokidar": "^3.5.3",
    "color-convert": "^2.0.1",
    "discord.js": "^13.6.0",
    "drivelist": "^12.0.2",
    "electron-dl": "^3.4.1",
    "electron-log": "^4.4.8",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.0",
    "eslint": "^7.23.0",
    "firebase": "^11.4.0",
    "fs-extra": "^10.0.0",
    "googleapis": "^100.0.0",
    "marked": "^15.0.12",
    "mixpanel-browser": "^2.47.0",
    "monaco-editor": "^0.34.0",
    "monaco-types": "^0.1.0",
    "node-disk-info": "^1.3.0",
    "node-fetch": "^2.6.7",
    "number-to-words": "^1.2.4",
    "panzoom": "^9.3.0",
    "redefine-custom-elements": "^0.1.3",
    "semver": "^7.5.4",
    "set-interval-async": "^3.0.3",
    "svelte-easy-popover": "^1.0.0",
    "svelte-splitpanes": "0.8.0",
    "svelte-tiny-virtual-list": "^2.1.2",
    "svelte-watch-resize": "^1.0.3",
    "ts-jest": "^29.1.2",
    "typescript": "^5.0.0",
    "usb": "^2.15.0",
    "uuid": "^9.0.0",
    "vite": "^4.5.14",
    "ws": "^7.5.8"
  },
  "scripts": {
    "e:builder": "cross-env VITE_BUILD_TARGET=electron NOTARIZE=true electron-builder --config electron-builder-config.js --publish onTagOrDraft",
    "e:builder:nightly": "cross-env VITE_BUILD_ENV=nightly VITE_BUILD_TARGET=electron NOTARIZE=true DEBUG=electron-notarize* electron-builder --config electron-builder-config.js --publish never",
    "e:builder:local": "cross-env VITE_BUILD_ENV=nightly VITE_BUILD_TARGET=electron DEBUG=electron-builder DEBUG=electron-notarize* electron-builder --config electron-builder-config.js --publish never",
    "export": "cross-env VITE_BUILD_ENV=production run-s s:build e:builder",
    "export:nightly": "run-s s:build e:builder:nightly",
    "export:alpha": "cross-env VITE_BUILD_ENV=alpha run-s s:build e:builder",
    "export:local": "run-s clean-up s:build e:builder:local",
    "clean-up": "rm -rf dist && rm -rf dist-web && rm -rf build",
    "rebuild": "./node_modules/.bin/electron-rebuild.cmd",
    "s:build": "electron-vite build",
    "preinstall": "node ./build-scripts/check-node-version.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "mocha",
    "electron:dev": "cross-env NODE_OPTIONS=--max_old_space_size=8198 VITE_BUILD_TARGET=electron VITE_BUILD_ENV=development electron-vite dev --watch",
    "electron-dev": "npm run electron:dev",
    "fix-permissions": "sudo chown root ./node_modules/electron/dist/chrome-sandbox && sudo chmod 4755 ./node_modules/electron/dist/chrome-sandbox",
    "format": "prettier --write .",
    "web:dev": "vite dev --mode web",
    "web:build": "vite build --mode web",
    "web:deploy": "firebase deploy --only hosting",
    "web-dev": "cross-env VITE_BUILD_TARGET=web VITE_BUILD_ENV=development npm run web:dev",
    "web-build": "cross-env VITE_BUILD_TARGET=web VITE_BUILD_ENV=production run-s clean-up web:build",
    "web-deploy": "run-s web-build web:deploy"
  }
}
