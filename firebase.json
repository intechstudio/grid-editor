{
  "hosting": [
    {
      "target": "default",
      "public": "dist-web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/src/renderer/index.html"
        }
      ]
    },
    {
      "target": "playwright-preview",
      "public": "playwright-report",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    }
  ]
}
