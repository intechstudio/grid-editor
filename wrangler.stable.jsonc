{
  // Always-on target tracking the head of the stable branch. Separate Worker
  // rather than a preview alias, because version preview URLs cannot use a
  // custom domain.
  "name": "grid-editor-stable",
  "compatibility_date": "2026-09-01",
  // Reachable only at stable.grid-editor.app. This Worker is always deployed
  // and never uploaded as a preview, so it needs neither.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist-web",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "stable.grid-editor.app", "custom_domain": true }]
}
